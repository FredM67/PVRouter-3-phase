# Hardware shared by the scenarios - matches the default config.h and calibration.h
#
# mains <frequency Hz> <Vrms>
mains 50 230
# f_voltageCal and f_powerCal from calibration.h: the firmware must read back
# the voltages and powers the simulator generates
vcal 0.8151 0.8184 0.8195
pcal 0.05 0.05 0.05

# load <pin> <phase 1-3> <W>: physicalLoadPin[] = { 5, 6, 7 }, priorities 0, 1, 2
load 5 1 2000
load 6 2 2000
load 7 3 2000

# D4 is the override pin (active LOW): keep it released
input 4 1
