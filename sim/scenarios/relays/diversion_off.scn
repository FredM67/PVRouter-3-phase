# Diversion pin (D3) LOW with a large surplus: the surplus is not diverted any more, on the
# triac loads (at once) and on the relays (after their minimum ON time). Forcing still works
# with diversion OFF: the override pin (D4) brings every load and relay in again, the
# relays as soon as their minimum OFF time and the settle time allow.
include common.scn
duration 390

at 0   -200 -200 -200
at 30  -200 -200 -200
at 30  2000 2000 2000   # 6000 W: triac loads on (3000 W), 3000 W exported
at 390 2000 2000 2000

input 3 0 200           # diversion OFF
input 4 0 310           # override: every load and relay forced

expect 190 pin 5 on
expect 190 pin 8 on
expect 205 pin 5 off    # no diversion any more
expect 205 pin 6 off
expect 205 pin 7 off
expect 205 pin 8 on     # within its minimum ON time
expect 260 pin 8 off
expect 300 pin 5 off    # still exporting 6000 W, still no diversion
expect 300 pin 9 off
expect 315 pin 5 on     # forced
expect 315 pin 6 on
expect 315 pin 7 on
expect 320 pin 9 on     # forced, minimum OFF time long over
expect 320 pin 8 off    # forced, but within its minimum OFF time
expect 385 pin 8 on
expect switches 8 2 2
expect switches 9 1 1
