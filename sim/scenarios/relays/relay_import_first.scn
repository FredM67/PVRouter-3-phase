# Import is cut at all costs: when it starts while relay 2 is still within its minimum
# ON time, relay 1 goes out first - whatever their order - and relay 2 once its
# minimum ON time is over.
include common.scn
duration 400

at 0   -200 -200 -200
at 30  -200 -200 -200
at 30  2000 2000 2000   # 6000 W: triac loads on (3000 W), 3000 W exported
at 200 2000 2000 2000
at 200 3000 3000 3000   # 9000 W: relay 1 on, still 4500 W exported
at 300 3000 3000 3000
at 300 -200 -200 -200   # import, while relay 2 is within its minimum ON time
at 400 -200 -200 -200

expect 290 pin 8 on
expect 290 pin 9 on
expect 340 pin 8 off    # out of order, to cut the import
expect 340 pin 9 on     # within its minimum ON time
expect 390 pin 9 off
expect switches 8 1 1
expect switches 9 1 1
