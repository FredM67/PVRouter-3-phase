# Surplus steps beyond what the triac loads absorb: relay 1 comes in at 1000 W of
# export, relay 2 at 2000 W, each once; with import they go out in reverse order,
# relay 1 a minute after relay 2 (the settle time after a change). If relay 2 were still
# within its minimum ON time, relay 1 would go out first: see relay_import_first.scn.
include common.scn
duration 425

at 0   -200 -200 -200
at 30  -200 -200 -200
at 30  2000 2000 2000   # 6000 W: triac loads on (3000 W), 3000 W exported
at 200 2000 2000 2000
at 200 3000 3000 3000   # 9000 W: relay 1 on, still 4500 W exported
at 340 3000 3000 3000
at 340 -200 -200 -200   # import, once relay 2's minimum ON time is over
at 425 -200 -200 -200

expect 110 pin 8 off    # exporting, but within its minimum OFF time from power-up
expect 190 pin 8 on
expect 190 pin 9 off
expect 330 pin 9 on
expect 390 pin 9 off
expect 390 pin 8 on     # waits for the settle time after relay 2
expect 420 pin 8 off
expect switches 8 1 1
expect switches 9 1 1
expect min_sample_sets 30
