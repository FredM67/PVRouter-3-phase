# Override pin (D4, every load and relay) pressed for a moment while the relays wait for
# the settle time after relay 1 came in. The relay engine handles relay overrides: it
# ignores this short press, so relay 2 never comes in. A relay pin driven by the override
# behind the engine's back would come in at once, and stay ON for good once released,
# since the engine still believes it is OFF.
include common.scn
duration 360

at 0   -200 -200 -200
at 30  -200 -200 -200
at 30  2000 2000 2000   # 6000 W: triac loads on (3000 W), 3000 W exported
at 240 2000 2000 2000
at 240 -200 -200 -200   # import: relay 1 goes out after its minimum ON time
at 360 -200 -200 -200

input 4 0 140           # pressed during the settle time after relay 1 came in
input 4 1 150           # released before the settle time is over

expect 130 pin 8 on
expect 145 pin 9 off
expect 200 pin 9 off
expect 355 pin 8 off
expect 355 pin 9 off
expect switches 8 1 1
expect switches 9 0 0
