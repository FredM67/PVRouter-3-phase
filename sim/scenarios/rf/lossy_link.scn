# Poor RF link: 10 % of the frames are lost, at random (the same ones on every run),
# never more than 3 in a row. With a refresh every 100 ms and a 500 ms link timeout,
# the receivers keep their loads. 4 frames lost in a row already make a 500 ms gap,
# right at the timeout: at 10 %, a few runs in a hundred have one, and any change of
# the firmware's timing moves the sequence to other frames (0.503 s for unit 15, #209).
include common.scn
duration 30
input 4 0    # override: every load forced on, the remote ones included

at 0 -200 -200 -200

rf_loss 10 3

expect 10 remote 15 0 on
expect 20 remote 15 0 on
expect 29 remote 15 0 on
expect 29 remote 16 0 on
expect rf_links_lost 15 0 0
expect rf_links_lost 16 0 0
