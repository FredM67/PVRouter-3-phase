# Override pin held low with no surplus: the router forces every load on, the
# remote ones included, over RF.
include common.scn
duration 20
input 4 0

at 0 -200 -200 -200

expect 10 pin 5 on
expect 10 pin 6 on
expect 10 remote 15 0 on
expect 19 remote 15 0 on
expect 19 remote 16 0 on
# a refresh every 5 mains cycles (100 ms); printing the datalog does not delay it
# (serial_output.h). The receiver's link timeout is 500 ms.
expect rf_max_gap 15 0.15
expect rf_max_gap 16 0.15
