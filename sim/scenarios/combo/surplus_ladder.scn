# Everything at once: surplus steps up through the four triac loads (two of them remote, a frame
# every 100 ms, RF datalog frames every 5 s) and the two relays, then falls to an import, with the
# two DS18B20 read every 5 s. Relay 1 comes in at 1000 W of export, relay 2 at 2000 W, each once.
include common.scn
duration 480

at 0   -200 -200 -200
at 30  -200 -200 -200
at 30  3300 3300 3300   # 9900 W: the four loads on (8000 W), 1900 W exported
at 200 3300 3300 3300
at 200 4000 4000 4000   # 12000 W: relay 1 on, then relay 2
at 380 4000 4000 4000
at 400 -200 -200 -200   # import: the relays go out
at 480 -200 -200 -200

expect 25 pin 5 off
expect 100 pin 5 on
expect 100 pin 6 on
expect 100 remote 15 0 on
expect 100 remote 16 0 on
expect 100 pin 8 off    # exporting, but within its minimum OFF time from power-up
expect 190 pin 8 on
expect 190 pin 9 off
expect 300 pin 8 on
expect 300 pin 9 on
expect 420 pin 9 off    # import: relay 2 first, after its minimum ON time
expect 420 pin 8 on     # relay 1 waits for the settle time after relay 2
expect 475 pin 8 off
expect 475 pin 5 off
expect switches 8 1 1
expect switches 9 1 1
# a refresh every 5 mains cycles (100 ms): the RF datalog frame and the 1-Wire bursts do not delay it
# beyond the receiver's link timeout (500 ms)
expect rf_max_gap 15 0.25
expect rf_max_gap 16 0.25
expect min_sample_sets 30
expect isr_overruns 0
expect misfiled_samples 0
